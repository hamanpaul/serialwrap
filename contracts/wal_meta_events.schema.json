{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "serialwrap WAL META events contract",
  "x-catalog-revision": 4,
  "type": "object",
  "oneOf": [
    {
      "title": "credentials_unresolved",
      "description": "登入憑證未解析警告事件",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "env_file",
        "event",
        "reason"
      ],
      "properties": {
        "event": {
          "const": "credentials_unresolved"
        },
        "reason": {
          "type": "string",
          "enum": [
            "not_configured",
            "ok",
            "env_file_missing",
            "env_file_unreadable",
            "key_absent"
          ],
          "description": "未解析原因"
        },
        "env_file": {
          "type": "string",
          "description": "宣告的 env 檔案路徑（未宣告時為空字串）"
        }
      }
    },
    {
      "title": "transport_stall_suspected",
      "description": "傳輸層停滯疑似警告事件",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "real_path",
        "rx_age_s"
      ],
      "properties": {
        "event": {
          "const": "transport_stall_suspected"
        },
        "real_path": {
          "type": "string",
          "description": "tty 裝置路徑（bridge.device_path，如 /dev/ttyUSB0；Windows 為 \\\\.\\COMn；取不到時為空字串）"
        },
        "rx_age_s": {
          "type": "number",
          "description": "自前次 RX 經過秒數"
        }
      }
    },
    {
      "title": "command_completion",
      "description": "命令帶 completion_regex 時於送出前寫入的稽核事件（外層 cmd_id 為該命令 ID）",
      "x-outer-record": {
        "dir": "META",
        "source": "system",
        "cmd_id": "string（非 null）"
      },
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completion_regex",
        "event"
      ],
      "properties": {
        "event": {
          "const": "command_completion"
        },
        "completion_regex": {
          "type": "string",
          "minLength": 1,
          "description": "valid_completion_regex 驗證過的完成條件（非空、UTF-8 ≤1024 bytes、不匹配空字串）"
        }
      }
    },
    {
      "title": "WAL_RECREATED_AFTER_EXTERNAL_UNLINK",
      "description": "外部 unlink／刪除後 WAL 重建事件",
      "x-status": "IMPLEMENTED",
      "x-behavior-change": "BC-01",
      "x-outer-record": {
        "dir": "META",
        "source": "system",
        "com": "WAL",
        "loss_flag": true
      },
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "potentially_lost_seq_range",
        "previous_identity",
        "range_known",
        "reason"
      ],
      "properties": {
        "event": {
          "const": "WAL_RECREATED_AFTER_EXTERNAL_UNLINK"
        },
        "reason": {
          "type": "string",
          "enum": [
            "external_unlink",
            "replaced",
            "dir_missing"
          ],
          "description": "重建原因"
        },
        "previous_identity": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]+:[0-9]+$",
          "description": "舊檔案識別資訊，十進位 <dev>:<ino> 或 Windows <VolumeSerialNumber>:<FileId128>"
        },
        "range_known": {
          "type": "boolean",
          "description": "遺失序號區間是否已知"
        },
        "potentially_lost_seq_range": {
          "type": [
            "array",
            "null"
          ],
          "description": "可能遺失的序號區間；range_known 為 true 時為 [first, last]，為 false 時為 null"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "range_known": {
                "const": true
              }
            },
            "required": [
              "range_known"
            ]
          },
          "then": {
            "properties": {
              "potentially_lost_seq_range": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1
                },
                "minItems": 2,
                "maxItems": 2,
                "x-constraint": "first <= last"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "range_known": {
                "const": false
              }
            },
            "required": [
              "range_known"
            ]
          },
          "then": {
            "properties": {
              "potentially_lost_seq_range": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    {
      "title": "WAL_ROTATED_AFTER_DEFERRAL",
      "description": "OD-19：延後的現行檔輪替於無新寫入的週期 tick 內完成時，於新現行檔首筆寫入的連續性 META（不改變 seq 續接語意）",
      "x-status": "IMPLEMENTED",
      "x-behavior-change": "OD-19",
      "x-outer-record": {
        "dir": "META",
        "source": "system",
        "com": "WAL",
        "loss_flag": false
      },
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archived_through_seq",
        "event"
      ],
      "properties": {
        "event": {
          "const": "WAL_ROTATED_AFTER_DEFERRAL"
        },
        "archived_through_seq": {
          "type": "integer",
          "minimum": 0,
          "description": "輪替前現行檔最後寫入的 seq（即歸檔段的最後一筆）；本筆 META 的 seq 為其 +1"
        }
      }
    },
    {
      "title": "tx_outcome_unknown",
      "description": "UART 寫入結果不明事件",
      "x-behavior-change": "BC-03",
      "x-outer-record": {
        "dir": "META",
        "source": "與原 TX 相同",
        "com": "與原 TX 相同",
        "cmd_id": "與原請求相同"
      },
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "requested_bytes",
        "confirmed_bytes",
        "unknown_range",
        "error"
      ],
      "properties": {
        "event": {
          "const": "tx_outcome_unknown"
        },
        "requested_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "confirmed_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "unknown_range": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2,
          "x-constraint": "[confirmed_bytes, requested_bytes]"
        },
        "error": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    {
      "title": "command_aborted_in_flight",
      "description": "已確認 UART 寫出至少 1 byte 後，命令在 drain 中止",
      "x-status": "IMPLEMENTED",
      "x-behavior-change": "BC-03",
      "x-outer-record": {
        "dir": "META",
        "source": "system",
        "cmd_id": "string（非 null）"
      },
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "confirmed_tx_bytes",
        "tx_outcome"
      ],
      "properties": {
        "event": {
          "const": "command_aborted_in_flight"
        },
        "confirmed_tx_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "tx_outcome": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "unknown"
          ]
        }
      }
    }
  ]
}
