  "feature": {
    "id": "08-logs-evidence",
    "order": 8,
    "title": "紀錄與證據",
    "summary": "UART 上每一段收發怎麼被記成可查的證據：WAL 雙軌寫入與輪替、讀取介面、per-session 的文字 log，以及 session 的活動分類。"
  },
  "repository": {
    "url": "https://github.com/hamanpaul/serialwrap",
    "revision": "12eb9a0ebead674a74bca58ffb0cd462074f0347"
  },
  "diagram_type": "sequence",
  "scope": {
    "includes": [
      "WAL 雙軌寫入：reader 的 RX 與 TxWriter 的 TX 經 WalWriter 寫入 raw.wal.ndjson 與 raw.mirror.log",
      "輪替與自癒：64 MiB 輪替、延後重試、檔案或目錄被刪除後的重建、健康狀態通知 Fence",
      "讀取與重置：log.tail_raw／log.tail_text／wal.range／wal.reset",
      "per-session capture：session.log_start／log_stop／log_status 與 reader 的寫入條件",
      "activity：session.activity 的分類依據"
    ],
    "excludes": [
      "背景命令的 BackgroundCapture 與 command.result_tail（屬於 01-command-exec）",
      "事件引擎的 events.ndjson（屬於 07-event-engine）",
      "WAL 紀錄的逐欄序列化格式與 CRC 計算細節",
      "daemon 停止序中的 WAL shutdown（屬於 09-daemon-mgmt）；`wal.current_seq` 只回目前序號，未另畫步驟",
      "SessionManager、OpRunner 與 daemon 主流程寫入的其他 WAL 紀錄（例如傳輸中止的 META）"
    ]
  },
