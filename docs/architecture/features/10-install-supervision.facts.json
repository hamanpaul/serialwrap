  "feature": {
    "id": "10-install-supervision",
    "order": 10,
    "title": "安裝與監管",
    "summary": "一個版本怎麼被裝上、換掉與退回，daemon 由誰負責常駐，以及出問題時怎麼診斷。"
  },
  "repository": {
    "url": "https://github.com/hamanpaul/serialwrap",
    "revision": "12eb9a0ebead674a74bca58ffb0cd462074f0347"
  },
  "diagram_type": "sequence",
  "scope": {
    "includes": [
      "安裝／更新／回滾：setup 帶 journal 的固定步驟與失敗時的還原",
      "一般 setup：資產物化與監管狀態 reconcile",
      "監管模式：on-demand、systemd-user、systemd-system、windows-task、windows-service 的切換（supervision-mode set）",
      "service 子命令與 on-demand 的自動啟動",
      "doctor 的檢查清單"
    ],
    "excludes": [
      "install.sh 與 Windows 安裝腳本取得、解壓 bundle 的過程（本頁從 CLI 的 setup 開始）",
      "com0com 選用元件的安裝與移除（setup --with-com0com／--remove-com0com）",
      "從 0.3.x 舊安裝交接的細節（legacy handoff）",
      "daemon 自己的啟動序與停止序（屬於 09-daemon-mgmt）；本頁只畫 CLI 對它發出的探測與停止要求",
      "journal 每個步驟的 crash 復原分支"
    ]
  },
