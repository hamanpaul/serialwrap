  "conflicts": [
    {
      "id": "conformance-doc-stale",
      "subject": "conformance 模組註解所描述的 PAL 實作狀態",
      "claims": [
        "crates/sw-pal/src/conformance/mod.rs:4-5 的註解說被測的 PAL 行為（PosixSerialBackend 等）仍為 unimplemented! 骨架。",
        "crates/sw-pal/src/lib.rs:213 與 268 在產品組裝點直接使用 PosixSerialBackend 與 WindowsSerialBackend，daemon 以它們開埠（crates/sw-core/src/session_manager.rs:4948）。"
      ],
      "resolution": "以組裝點與呼叫點為準：兩個序列埠後端已是產品路徑的一部分，conformance 模組的那段註解是早期階段留下的說明。"
    }
