        "frozen_at": {
          "type": "string",
          "minLength": 1
        },
        "waivable": {
          "const": false
        },
        "unauthorized_tx": {
          "const": 0
        },
        "forbidden_double_holder": {
          "const": 0
        },
        "cross_context_replay": {
          "const": 0
        },
        "dangerous_auto_resend": {
          "const": 0
        },
        "allowed_tx_source_regex": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "liveness": {
      "type": "object",
      "required": [
        "status",
        "frozen_at",
        "unexpected_daemon_exit",
        "unexpected_restart",
        "pid_generation_change",
        "worker_heartbeat_max_gap_s"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "frozen"
        },
        "frozen_at": {
          "type": "string",
          "minLength": 1
        },
        "unexpected_daemon_exit": {
          "const": 0
        },
        "unexpected_restart": {
          "const": 0
        },
        "pid_generation_change": {
          "const": 0
        },
        "worker_heartbeat_max_gap_s": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "require_pinned_cli",
        "require_engine_report",
        "require_observer",
        "require_wal_dir",
        "require_fault_retention_attestation",
        "require_windows_exclusive_evidence",
        "context_time_tolerance_s"
      ],
      "additionalProperties": false,
      "properties": {
        "require_pinned_cli": {
          "type": "boolean"
        },
        "require_engine_report": {
          "type": "boolean"
        },
        "require_observer": {
