{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "longrun_acceptance.v1",
  "description": "長跑發版門檻檔（longrun_acceptance.yaml）的結構契約。延後項（resources、min_effective_load、comparison_uncertainty）以 status 一次凍結兩平台；frozen 時兩平台欄位必須非 null 且符合型別，deferred 時全部為 null。",
  "type": "object",
  "required": [
    "schema_version",
    "revision",
    "authority",
    "owner_decisions",
    "workload",
    "counting",
    "thresholds",
    "safety",
    "liveness",
    "evidence"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "type": "string",
      "minLength": 1
    },
    "owner_decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "workload": {
      "type": "object",
      "required": [
        "engine_case",
        "engine_files",
        "min_continuous_duration_s",
        "allow_segment_stitching",
        "snapshot_interval_s",
        "observer_interval_s",
        "max_observation_gap_factor",
        "windows_excl_probe_interval_s"
      ],
      "additionalProperties": false,
      "properties": {
        "engine_case": {
          "type": "string",
          "minLength": 1
        },
        "engine_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "min_continuous_duration_s": {
          "type": "integer",
          "minimum": 1
        },
        "allow_segment_stitching": {
          "type": "boolean"
        },
        "snapshot_interval_s": {
          "type": "integer",
          "minimum": 1
        },
        "observer_interval_s": {
          "type": "integer",
          "minimum": 1
        },
        "max_observation_gap_factor": {
          "type": "number",
          "minimum": 1
        },
        "windows_excl_probe_interval_s": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "counting": {
      "type": "object",
      "required": [
        "status",
        "frozen_at",
        "pair_key",
        "expected_reject_kinds",
        "expected_reject_error_codes",
        "unresolved_policy",
        "worker_error_policy",
        "definitions"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "frozen"
        },
        "frozen_at": {
          "type": "string",
          "minLength": 1
        },
        "pair_key": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expected_reject_kinds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expected_reject_error_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unresolved_policy": {
          "type": "string"
        },
        "worker_error_policy": {
          "type": "string"
        },
        "definitions": {
          "type": "object",
          "required": [
            "submitted",
            "completed",
            "bg_lost",
            "expected_rejects",
            "unexpected_errors",
            "unresolved",
            "accepted",
            "error_rate",
            "effective_duration_s",
            "effective_hour"
          ],
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "thresholds": {
      "type": "object",
      "required": [
        "unexpected_cmd_error_rate",
        "effective_throughput",
        "stuck_attached",
        "resources",
        "min_effective_load",
        "comparison_uncertainty"
      ],
      "additionalProperties": false,
      "properties": {
        "unexpected_cmd_error_rate": {
          "$ref": "#/$defs/frozen_unexpected_cmd_error_rate"
        },
        "effective_throughput": {
          "$ref": "#/$defs/frozen_effective_throughput"
        },
        "stuck_attached": {
          "$ref": "#/$defs/frozen_stuck_attached"
        },
        "resources": {
          "$ref": "#/$defs/deferred_resources"
        },
        "min_effective_load": {
          "$ref": "#/$defs/deferred_min_effective_load"
        },
        "comparison_uncertainty": {
          "$ref": "#/$defs/deferred_comparison_uncertainty"
        }
