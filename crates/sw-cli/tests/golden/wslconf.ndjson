{"case": "section_header_spacing_preserved", "input": "[ boot ]\nvalue = kept\n[ ]\nempty = named\n", "expected": "[ boot ]\nvalue = kept\n\n[ ]\nempty = named\n\n[boot]\nsystemd = true\n\n"}
{"case": "blank_line_in_continuation", "input": "[user]\ncommand = first\n\n\tthird\n[boot]\nsystemd=false\n", "expected": "[user]\ncommand = first\n\t\n\tthird\n\n[boot]\nsystemd = true\n\n"}
