{"case": "bad_format_duplicate_section", "input": "[boot]\nsystemd=false\n[boot]\n", "expected": "[boot]\nsystemd = true\n\n"}
{"case": "bad_format_duplicate_option", "input": "[boot]\nsystemd=false\nsystemd=true\n", "expected": "[boot]\nsystemd = true\n\n"}
