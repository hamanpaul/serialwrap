{"case": "key_colon_value", "input": "[user]\ndefault: alice\n", "expected": "[user]\ndefault = alice\n\n[boot]\nsystemd = true\n\n"}
{"case": "continuation_line", "input": "[automount]\noptions = metadata,\n\tumask=22\n", "expected": "[automount]\noptions = metadata,\n\tumask=22\n\n[boot]\nsystemd = true\n\n"}
